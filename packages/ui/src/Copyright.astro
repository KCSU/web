---
// The year is set at build time and refreshed in the browser.
---
&copy; <span data-copyright-year>{new Date().getUTCFullYear()}</span> King’s College Student Union. All rights reserved.

<script>
  document.querySelectorAll('[data-copyright-year]').forEach((year) => {
    year.textContent = String(new Date().getUTCFullYear());
  });
</script>
