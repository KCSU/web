{
  "hosting": [
    {
      "target": "site",
      "public": "apps/site/dist",
      "ignore": [
        "**/.*"
      ],
      "cleanUrls": true,
      "trailingSlash": false,
      "redirects": [
        {
          "source": "/about-us/team",
          "destination": "/about-us/exec",
          "type": 301
        },
        {
          "source": "/societies/academic",
          "destination": "/societies?category=academic",
          "type": 301
        },
        {
          "source": "/societies/sports",
          "destination": "/societies?category=sports",
          "type": 301
        },
        {
          "source": "/societies/others",
          "destination": "/societies?category=other",
          "type": 301
        },
        {
          "source": "/about-us/history",
          "destination": "/about-us/exec",
          "type": 301
        },
        {
          "source": "/documents/college_map.pdf",
          "destination": "/documents/college-map.pdf",
          "type": 301
        }
      ],
      "headers": [
        {
          "source": "/_astro/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/!(*.*)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "status",
      "public": "apps/status/dist",
      "ignore": [
        "**/.*"
      ],
      "headers": [
        {
          "source": "/_astro/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    }
  ]
}
