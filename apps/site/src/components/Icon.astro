---
// A Font Awesome icon, inlined as an SVG at build time.
import type { IconDefinition } from '@fortawesome/fontawesome-common-types';

interface Props {
  icon: IconDefinition;
  fixedWidth?: boolean;
  class?: string;
}

const { icon, fixedWidth = false, class: className } = Astro.props;
const [width, height, , , path] = icon.icon;
---

<svg
  class:list={['inline-block h-[1em] overflow-visible align-[-0.125em]', fixedWidth ? 'w-[1.25em]' : 'w-auto', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${width} ${height}`}
  fill="currentColor"
  aria-hidden="true"
>
  {(Array.isArray(path) ? path : [path]).map((d) => <path d={d} />)}
</svg>
