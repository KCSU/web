---
import type { IconDefinition } from '@fortawesome/free-solid-svg-icons';
import Icon from '../Icon';
import Link from '../Link';

interface Props {
  href: string;
  label: string;
  /** For links that aren't web pages, e.g. a PDF or an email address. */
  icon?: IconDefinition;
}

const { href, label, icon } = Astro.props;
---

<li>
  <Link href={href}>{label}{icon && <>&nbsp;<Icon icon={icon} class="text-xs" /></>}</Link>
</li>
