---
import ContentLayout from '../../layouts/ContentLayout.astro';
import Exec from '../../components/exec/Exec';
import { fetchExec } from '../../lib/exec';
import Link from '../../components/Link';

// Fetched at build time.
const exec = await fetchExec();
---

<ContentLayout
  title="The Exec"
  description="The KCSU Executive Committee consists of officers elected to represent undergraduates at King’s College, Cambridge."
  heading="Meet the Exec"
  updatedAt={exec.updated_at}
>
  <Fragment slot="intro">
    The KCSU is made up of a group of King’s students who have been elected in accordance with the
    Constitution to represent the views of the undergraduate student body. Each member of the KCSU is
    responsible for a specific area of our work. Find out more about us below!
  </Fragment>

  <Exec client:load roles={exec.roles} />

  <Fragment slot="note">
    This page is subject to change. For any queries, please contact
    <Link href="mailto:president@kcsu.org.uk">the KCSU President</Link>.
  </Fragment>
</ContentLayout>
