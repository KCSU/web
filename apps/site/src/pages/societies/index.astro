---
import { faArrowRight } from '@fortawesome/free-solid-svg-icons';
import ContentLayout from '../../layouts/ContentLayout.astro';
import Icon from '../../components/Icon';
import Societies from '../../components/societies/Societies';
import { fetchSocieties } from '../../lib/societies';
import Link from '../../components/Link';

// Fetched at build time.
const { updated_at, societies } = await fetchSocieties();
---

<ContentLayout
  title="Societies"
  description="Clubs and societies at King’s College, Cambridge, and how to get in touch with them."
  heading="Societies"
  updatedAt={updated_at}
>
  <Fragment slot="intro">
    King’s College has {societies.length} student-run clubs and societies, open to all KCSU members.
  </Fragment>

  <Societies client:load societies={societies} />

  <aside class="mt-16 bg-white p-8 rounded-xl border border-gray-300 border-l-[6px] border-l-primary">
    <h2 class="text-2xl font-bold text-gray-900 mb-3">Start your own society</h2>
    <p class="text-gray-700 mb-6">
      Want to start something new at King’s? The KCSU is always happy to welcome new societies. The Sports &amp;
      Societies Officer can help you set one up and apply for funding.
    </p>
    <a
      href="mailto:sports.societies@kcsu.org.uk"
      class="inline-flex items-center px-4 py-2 bg-primary text-white rounded-lg hover:bg-purple-900"
    >
      Email the Sports &amp; Societies Officer
      <Icon icon={faArrowRight} class="ml-2" />
    </a>
  </aside>

  <Fragment slot="note">
    Is something here out of date? Email the Sports &amp; Societies Officer at
    <Link href="mailto:sports.societies@kcsu.org.uk">sports.societies@kcsu.org.uk</Link>.
  </Fragment>
</ContentLayout>
