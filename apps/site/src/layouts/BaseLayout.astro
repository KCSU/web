---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import NavBar from '../components/NavBar.astro';

interface Props {
  title?: string;
  description?: string;
}

const SITE_NAME = 'King’s College SU';
const DEFAULT_DESCRIPTION =
  'King’s College Student Union is the undergraduate representative body at King’s College, Cambridge.';

const { title, description = DEFAULT_DESCRIPTION } = Astro.props;

const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/favicon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-icon-180x180.png" />
    <meta name="theme-color" content="#59276c" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body class="flex flex-col min-h-screen">
    <NavBar />
    <main class="grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
